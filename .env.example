# Copy to .env and fill in. Never commit .env.

# Airwallex sandbox: sandbox.airwallex.com -> Account > Developer > API keys
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com

# Filled in by `npm run sandbox:setup` (needs connected accounts + platform payments enabled by Airwallex)
AIRWALLEX_BORROWER_ACCOUNTS=
AIRWALLEX_GLOBAL_ACCOUNTS=

# Optional
# AIRWALLEX_DISBURSE_REASON=professional_business_services   # closed enum, verify with the docs MCP
# AIRWALLEX_COLLECT_REASON=professional_business_services
# AIRWALLEX_INDUSTRY_CODE=ICCV3_XXXXXX
# KEEL_FUND_USD=100000

# Optional: Claude writes the credit memos (npm run demo:llm)
ANTHROPIC_API_KEY=

# Optional: approvals in Slack (npm run demo:sandbox -- --approve slack)
# Slack: api.slack.com/apps -> Create app -> Incoming Webhooks -> Add to a channel -> copy the URL
SLACK_WEBHOOK_URL=
# Where approval links and Airwallex webhooks reach this machine. Default http://localhost:8788
# KEEL_PUBLIC_URL=https://your-tunnel.trycloudflare.com
# KEEL_PORT=8788
# KEEL_APPROVAL_TIMEOUT_MIN=30

# Optional: Airwallex webhooks (Developer -> Webhooks -> notification URL = KEEL_PUBLIC_URL/webhooks/airwallex,
# events connected_account_transfer.* and charge.*). Paste that URL's secret here.
AIRWALLEX_WEBHOOK_SECRET=

# Optional: Kopi Roasters sells and repays in SGD on the sandbox too (first: npm run sandbox:setup -- --fx)
# KEEL_FX=1
